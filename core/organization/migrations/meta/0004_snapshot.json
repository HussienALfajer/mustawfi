          "value": "(\"core_organization\".\"store_profiles\".\"logo\" is null and \"core_organization\".\"store_profiles\".\"logo_type\" is null and \"core_organization\".\"store_profiles\".\"logo_sha256\" is null and \"core_organization\".\"store_profiles\".\"logo_size\" is null)\n        or (\"core_organization\".\"store_profiles\".\"logo_type\" in ('image/png', 'image/jpeg') and \"core_organization\".\"store_profiles\".\"logo_sha256\" ~ '^[0-9a-f]{64}$'\n          and \"core_organization\".\"store_profiles\".\"logo_size\" = octet_length(\"core_organization\".\"store_profiles\".\"logo\") and \"core_organization\".\"store_profiles\".\"logo_size\" between 1 and 262144)"
