{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./secrets/**)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(rm -rf *)",
      "Bash(gh repo delete *)",
      "PowerShell(Remove-Item *)"
    ]
  },
  "deniedMcpServers": [
    { "serverName": "hostinger" },
    { "serverName": "hostinger-dns" },
    { "serverName": "claude-in-chrome" },
    { "serverName": "mcp-registry" }
  ],
  "disableClaudeAiConnectors": true
}
